#include <cstdint>

#include "persistent_bucket_pad_common.h"
#include "simt_api/asc_fp16.h"

namespace aten_softmax_v3 {
namespace persistent_128_detail {

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
void dispatch_row_persistent_forward_kernel_128(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  if (dim_size <= 64) {
    launch_row_softmax_persistent_bucket_pad_kernel<
        scalar_t,
        accscalar_t,
        outscalar_t,
        64>(input_ptr, output_ptr, outer_size, dim_size, grid_x, acl_stream);
    return;
  }
  launch_row_softmax_persistent_bucket_pad_kernel<
      scalar_t,
      accscalar_t,
      outscalar_t,
      128>(input_ptr, output_ptr, outer_size, dim_size, grid_x, acl_stream);
}

} // namespace persistent_128_detail

void dispatch_row_persistent_forward_kernel_128_fp16(
    const __fp16* input_ptr,
    __fp16* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  persistent_128_detail::dispatch_row_persistent_forward_kernel_128<
      __fp16,
      float,
      __fp16>(input_ptr, output_ptr, outer_size, dim_size, grid_x, acl_stream);
}

void dispatch_row_persistent_forward_kernel_128_fp32(
    const float* input_ptr,
    float* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  persistent_128_detail::dispatch_row_persistent_forward_kernel_128<
      float,
      float,
      float>(input_ptr, output_ptr, outer_size, dim_size, grid_x, acl_stream);
}

} // namespace aten_softmax_v3
