#include <torch/all.h>

#include <cstdint>
#include <limits>
#include <type_traits>

#include "c_api/asc_simd.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_simt.h"

namespace aten_softmax_v3 {
namespace {

template <typename T>
struct Add {
  __simt_callee__ inline T operator()(T a, T b) const {
    return a + b;
  }
};

template <typename T>
struct Max {
  __simt_callee__ inline T operator()(T a, T b) const {
    return a < b ? b : a;
  }
};

template <typename T>
__simt_callee__ inline T fast_warp_reduce_sum(T val) {
#pragma unroll
  for (int offset = 16; offset > 0; offset >>= 1) {
    val += asc_shfl_down(val, static_cast<uint32_t>(offset), 32);
  }
  return val;
}

template <typename T>
__simt_callee__ inline T fast_warp_reduce_max(T val) {
#pragma unroll
  for (int offset = 16; offset > 0; offset >>= 1) {
    val = Max<T>()(val, asc_shfl_down(val, static_cast<uint32_t>(offset), 32));
  }
  return val;
}

template <typename T, template <typename> class ReduceOp>
__simt_callee__ inline T fast_block_reduce_warp(
    __ubuf__ T* shared,
    T val,
    T identity) {
  const int64_t lane = threadIdx.x % 32;
  const int64_t warp = threadIdx.x / 32;
  if constexpr (std::is_same_v<ReduceOp<T>, Add<T>>) {
    val = fast_warp_reduce_sum(val);
  } else {
    val = fast_warp_reduce_max(val);
  }

  __syncthreads();
  if (lane == 0) {
    shared[warp] = val;
  }
  __syncthreads();

  T block_val = identity;
  if (warp == 0) {
    const int64_t warps_per_block = blockDim.x / 32;
    block_val = lane < warps_per_block ? shared[lane] : identity;
    if constexpr (std::is_same_v<ReduceOp<T>, Add<T>>) {
      block_val = fast_warp_reduce_sum(block_val);
    } else {
      block_val = fast_warp_reduce_max(block_val);
    }
    if (lane == 0) {
      shared[0] = block_val;
    }
  }
  __syncthreads();
  return shared[0];
}

template <typename T, template <typename> class ReduceOp>
__simt_callee__ inline T fast_block_reduce_warp_inverse(
    __ubuf__ T* shared,
    T val,
    T identity) {
  const T sum = fast_block_reduce_warp<T, ReduceOp>(shared, val, identity);
  if (threadIdx.x == 0) {
    shared[0] = static_cast<T>(1) / sum;
  }
  __syncthreads();
  return shared[0];
}

template <template <typename, typename> class Reduction, int64_t kILP, typename scalar_t, typename accscalar_t>
__simt_callee__ inline accscalar_t fast_ilp_reduce(
    __gm__ const scalar_t* data,
    int64_t size,
    const Reduction<scalar_t, accscalar_t>& reduction,
    accscalar_t identity) {
  accscalar_t thread_value = identity;
  for (int64_t offset = threadIdx.x * kILP; offset < size;
       offset += blockDim.x * kILP) {
#pragma unroll
    for (int64_t i = 0; i < kILP; ++i) {
      const int64_t element_offset = offset + i;
      if (element_offset < size) {
        thread_value = reduction(thread_value, data[element_offset]);
      }
    }
  }
  return thread_value;
}

template <int64_t kILP, typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_callee__ inline void fast_ilp_softmax_write(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t size,
    accscalar_t max_input,
    accscalar_t inv_sum) {
  for (int64_t offset = threadIdx.x * kILP; offset < size;
       offset += blockDim.x * kILP) {
#pragma unroll
    for (int64_t i = 0; i < kILP; ++i) {
      const int64_t element_offset = offset + i;
      if (element_offset < size) {
        output[element_offset] = static_cast<outscalar_t>(
            __expf(static_cast<accscalar_t>(input[element_offset]) - max_input) *
            inv_sum);
      }
    }
  }
}

template <template <typename, typename> class Reduction, typename accscalar_t>
__simt_callee__ inline accscalar_t fast_fp16x2_reduce(
    __gm__ const __fp16* data,
    int64_t size,
    int64_t shift,
    const Reduction<__fp16, accscalar_t>& reduction,
    accscalar_t identity) {
  accscalar_t thread_value = identity;
  if (shift != 0 && threadIdx.x == 0) {
    thread_value = reduction(thread_value, data[0]);
  }

  __gm__ const __fp16* aligned_data = data + shift;
  const int64_t aligned_size = size - shift;
  __gm__ const half2* vector_data = (__gm__ const half2*)aligned_data;
  const int64_t half2_size = aligned_size / 2;
  for (int64_t pair_offset = threadIdx.x; pair_offset < half2_size;
       pair_offset += blockDim.x) {
    const half2 pair = vector_data[pair_offset];
    thread_value = reduction(
        thread_value,
        static_cast<__fp16>(__low2float(pair)));
    thread_value = reduction(
        thread_value,
        static_cast<__fp16>(__high2float(pair)));
  }
  if ((aligned_size % 2) != 0 && threadIdx.x == 0) {
    thread_value = reduction(thread_value, data[size - 1]);
  }
  return thread_value;
}

template <template <typename, typename> class Reduction, typename accscalar_t>
__simt_callee__ inline accscalar_t fast_fp16x4_reduce(
    __gm__ const __fp16* data,
    int64_t size,
    const Reduction<__fp16, accscalar_t>& reduction,
    accscalar_t identity) {
  __gm__ const half2* vector_data = (__gm__ const half2*)data;
  const int64_t half2_size = size / 2;
  accscalar_t thread_value = identity;
  for (int64_t pair_offset = threadIdx.x * 2; pair_offset < half2_size;
       pair_offset += blockDim.x * 2) {
    const half2 first_pair = vector_data[pair_offset];
    thread_value = reduction(
        thread_value,
        static_cast<__fp16>(__low2float(first_pair)));
    thread_value = reduction(
        thread_value,
        static_cast<__fp16>(__high2float(first_pair)));

    const half2 second_pair = vector_data[pair_offset + 1];
    thread_value = reduction(
        thread_value,
        static_cast<__fp16>(__low2float(second_pair)));
    thread_value = reduction(
        thread_value,
        static_cast<__fp16>(__high2float(second_pair)));
  }
  return thread_value;
}

__simt_callee__ inline void fast_fp16x4_write(
    __gm__ __fp16* output,
    __gm__ const __fp16* input,
    int64_t size,
    float max_input,
    float inv_sum) {
  __gm__ const half2* vector_input = (__gm__ const half2*)input;
  __gm__ half2* vector_output = (__gm__ half2*)output;
  const int64_t half2_size = size / 2;
  for (int64_t pair_offset = threadIdx.x * 2; pair_offset < half2_size;
       pair_offset += blockDim.x * 2) {
    const half2 first_pair = vector_input[pair_offset];
    const float first_low =
        __expf(__low2float(first_pair) - max_input) * inv_sum;
    const float first_high =
        __expf(__high2float(first_pair) - max_input) * inv_sum;
    vector_output[pair_offset] =
        __floats2half2_rn(first_low, first_high);

    const half2 second_pair = vector_input[pair_offset + 1];
    const float second_low =
        __expf(__low2float(second_pair) - max_input) * inv_sum;
    const float second_high =
        __expf(__high2float(second_pair) - max_input) * inv_sum;
    vector_output[pair_offset + 1] =
        __floats2half2_rn(second_low, second_high);
  }
}

__simt_callee__ inline void fast_fp16x2_write(
    __gm__ __fp16* output,
    __gm__ const __fp16* input,
    int64_t size,
    int64_t shift,
    float max_input,
    float inv_sum) {
  if (shift != 0 && threadIdx.x == 0) {
    output[0] = static_cast<__fp16>(
        __expf(static_cast<float>(input[0]) - max_input) * inv_sum);
  }

  __gm__ const __fp16* aligned_input = input + shift;
  __gm__ __fp16* aligned_output = output + shift;
  const int64_t aligned_size = size - shift;
  __gm__ const half2* vector_input = (__gm__ const half2*)aligned_input;
  __gm__ half2* vector_output = (__gm__ half2*)aligned_output;
  const int64_t half2_size = aligned_size / 2;
  for (int64_t pair_offset = threadIdx.x; pair_offset < half2_size;
       pair_offset += blockDim.x) {
    const half2 pair = vector_input[pair_offset];
    const float low = __expf(__low2float(pair) - max_input) * inv_sum;
    const float high = __expf(__high2float(pair) - max_input) * inv_sum;
    vector_output[pair_offset] = __floats2half2_rn(low, high);
  }
  if ((aligned_size % 2) != 0 && threadIdx.x == 0) {
    output[size - 1] = static_cast<__fp16>(
        __expf(static_cast<float>(input[size - 1]) - max_input) * inv_sum);
  }
}

template<typename T, typename AccumT>
struct MaxFloat {
  __simt_callee__ inline AccumT operator()(AccumT current, T value) const {
    return Max<AccumT>()(current, static_cast<AccumT>(value));
  }
};

template<typename T, typename AccumT>
struct SumExpfFloat {
  __simt_callee__ inline SumExpfFloat(AccumT max_value) : max_value(max_value) {}

  __simt_callee__ inline AccumT operator()(AccumT current, T value) const {
    return current + __expf(static_cast<AccumT>(value) - max_value);
  }

  const AccumT max_value;
};

template <typename scalar_t>
__aicore__ inline __gm__ scalar_t* mutable_gm_ptr(__gm__ const scalar_t* ptr) {
  return const_cast<__gm__ scalar_t*>(ptr);
}

constexpr int64_t kUsableUbBytes = 224 * 1024;
constexpr int64_t kLargeRowUbDataBytes = 220 * 1024;
constexpr int64_t kLargeRowFp16TileElements =
    kLargeRowUbDataBytes / (2 * sizeof(__fp16));
constexpr int64_t kLargeRowFp32TileElements =
    kLargeRowUbDataBytes / (2 * sizeof(float));
constexpr int64_t kLargeRowReduceWarpCount = 1024 / 32;

static_assert(
    2 * kLargeRowFp16TileElements * sizeof(__fp16) +
        kLargeRowReduceWarpCount * sizeof(float) + 2 * sizeof(float) <=
        kUsableUbBytes,
    "fp16 large-row tile exceeds the 224 KiB UB budget");
static_assert(
    2 * kLargeRowFp32TileElements * sizeof(float) +
        kLargeRowReduceWarpCount * sizeof(float) + 2 * sizeof(float) <=
        kUsableUbBytes,
    "fp32 large-row tile exceeds the 224 KiB UB budget");

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_large_row_forward_vf(
    __ubuf__ outscalar_t* output_ub,
    __ubuf__ const scalar_t* input_ub,
    int32_t tile_size,
    __ubuf__ accscalar_t* shared) {
  constexpr int32_t kLargeRowILP = 4;
  accscalar_t thread_max = std::numeric_limits<accscalar_t>::lowest();
  if constexpr (std::is_same_v<scalar_t, __fp16>) {
    __ubuf__ const half2* vector_input =
        reinterpret_cast<__ubuf__ const half2*>(input_ub);
    const int32_t half2_size = tile_size / 2;
    const int32_t quad_half2_size = half2_size & ~3;
    for (int32_t pair_offset = threadIdx.x * 4; pair_offset < quad_half2_size;
         pair_offset += blockDim.x * 4) {
      const half2 first_pair = vector_input[pair_offset];
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__low2float(first_pair)));
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__high2float(first_pair)));
      const half2 second_pair = vector_input[pair_offset + 1];
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__low2float(second_pair)));
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__high2float(second_pair)));
      const half2 third_pair = vector_input[pair_offset + 2];
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__low2float(third_pair)));
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__high2float(third_pair)));
      const half2 fourth_pair = vector_input[pair_offset + 3];
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__low2float(fourth_pair)));
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(__high2float(fourth_pair)));
    }
    if ((half2_size & 3) != 0 && threadIdx.x == 0) {
      for (int32_t tail_offset = quad_half2_size; tail_offset < half2_size;
           ++tail_offset) {
        const half2 tail_pair = vector_input[tail_offset];
        thread_max = Max<accscalar_t>()(
            thread_max,
            static_cast<accscalar_t>(__low2float(tail_pair)));
        thread_max = Max<accscalar_t>()(
            thread_max,
            static_cast<accscalar_t>(__high2float(tail_pair)));
      }
    }
    if ((tile_size % 2) != 0 && threadIdx.x == 0) {
      thread_max = Max<accscalar_t>()(
          thread_max,
          static_cast<accscalar_t>(input_ub[tile_size - 1]));
    }
  } else {
    for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_size;
         offset += blockDim.x * kLargeRowILP) {
#pragma unroll
      for (int32_t i = 0; i < kLargeRowILP; ++i) {
        const int32_t element_offset = offset + i;
        if (element_offset < tile_size) {
          thread_max = Max<accscalar_t>()(
              thread_max,
              static_cast<accscalar_t>(input_ub[element_offset]));
        }
      }
    }
  }
  const accscalar_t row_max = fast_block_reduce_warp<accscalar_t, Max>(
      shared,
      thread_max,
      std::numeric_limits<accscalar_t>::lowest());
  accscalar_t thread_sum = static_cast<accscalar_t>(0);
  if constexpr (std::is_same_v<scalar_t, __fp16>) {
    __ubuf__ const half2* vector_input =
        reinterpret_cast<__ubuf__ const half2*>(input_ub);
    const int32_t half2_size = tile_size / 2;
    const int32_t quad_half2_size = half2_size & ~3;
    for (int32_t pair_offset = threadIdx.x * 4; pair_offset < quad_half2_size;
         pair_offset += blockDim.x * 4) {
      const half2 first_pair = vector_input[pair_offset];
      thread_sum += __expf(
          static_cast<accscalar_t>(__low2float(first_pair)) - row_max);
      thread_sum += __expf(
          static_cast<accscalar_t>(__high2float(first_pair)) - row_max);
      const half2 second_pair = vector_input[pair_offset + 1];
      thread_sum += __expf(
          static_cast<accscalar_t>(__low2float(second_pair)) - row_max);
      thread_sum += __expf(
          static_cast<accscalar_t>(__high2float(second_pair)) - row_max);
      const half2 third_pair = vector_input[pair_offset + 2];
      thread_sum += __expf(
          static_cast<accscalar_t>(__low2float(third_pair)) - row_max);
      thread_sum += __expf(
          static_cast<accscalar_t>(__high2float(third_pair)) - row_max);
      const half2 fourth_pair = vector_input[pair_offset + 3];
      thread_sum += __expf(
          static_cast<accscalar_t>(__low2float(fourth_pair)) - row_max);
      thread_sum += __expf(
          static_cast<accscalar_t>(__high2float(fourth_pair)) - row_max);
    }
    if ((half2_size & 3) != 0 && threadIdx.x == 0) {
      for (int32_t tail_offset = quad_half2_size; tail_offset < half2_size;
           ++tail_offset) {
        const half2 tail_pair = vector_input[tail_offset];
        thread_sum += __expf(
            static_cast<accscalar_t>(__low2float(tail_pair)) - row_max);
        thread_sum += __expf(
            static_cast<accscalar_t>(__high2float(tail_pair)) - row_max);
      }
    }
    if ((tile_size % 2) != 0 && threadIdx.x == 0) {
      thread_sum += __expf(
          static_cast<accscalar_t>(input_ub[tile_size - 1]) - row_max);
    }
  } else {
    for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_size;
         offset += blockDim.x * kLargeRowILP) {
#pragma unroll
      for (int32_t i = 0; i < kLargeRowILP; ++i) {
        const int32_t element_offset = offset + i;
        if (element_offset < tile_size) {
          thread_sum += __expf(
              static_cast<accscalar_t>(input_ub[element_offset]) - row_max);
        }
      }
    }
  }
  const accscalar_t inv_sum = fast_block_reduce_warp_inverse<accscalar_t, Add>(
      shared,
      thread_sum,
      static_cast<accscalar_t>(0));
  if constexpr (
      std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16>) {
    __ubuf__ const half2* vector_input =
        reinterpret_cast<__ubuf__ const half2*>(input_ub);
    __ubuf__ half2* vector_output =
        reinterpret_cast<__ubuf__ half2*>(output_ub);
    const int32_t half2_size = tile_size / 2;
    if ((tile_size % 4) == 0) {
      for (int32_t pair_offset = threadIdx.x * 2; pair_offset < half2_size;
           pair_offset += blockDim.x * 2) {
        const half2 first_pair = vector_input[pair_offset];
        vector_output[pair_offset] = __floats2half2_rn(
            __expf(__low2float(first_pair) - row_max) * inv_sum,
            __expf(__high2float(first_pair) - row_max) * inv_sum);

        const half2 second_pair = vector_input[pair_offset + 1];
        vector_output[pair_offset + 1] = __floats2half2_rn(
            __expf(__low2float(second_pair) - row_max) * inv_sum,
            __expf(__high2float(second_pair) - row_max) * inv_sum);
      }
    } else {
      for (int32_t pair_offset = threadIdx.x; pair_offset < half2_size;
           pair_offset += blockDim.x) {
        const half2 pair = vector_input[pair_offset];
        vector_output[pair_offset] = __floats2half2_rn(
            __expf(__low2float(pair) - row_max) * inv_sum,
            __expf(__high2float(pair) - row_max) * inv_sum);
      }
      if ((tile_size % 2) != 0 && threadIdx.x == 0) {
        output_ub[tile_size - 1] = static_cast<outscalar_t>(
            __expf(
                static_cast<accscalar_t>(input_ub[tile_size - 1]) - row_max) *
            inv_sum);
      }
    }
    return;
  }
  for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_size;
       offset += blockDim.x * kLargeRowILP) {
#pragma unroll
    for (int32_t i = 0; i < kLargeRowILP; ++i) {
      const int32_t element_offset = offset + i;
      if (element_offset < tile_size) {
        output_ub[element_offset] = static_cast<outscalar_t>(
            __expf(
                static_cast<accscalar_t>(input_ub[element_offset]) - row_max) *
            inv_sum);
      }
    }
  }
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t, int64_t kTileElements>
__aicore__ inline void row_softmax_fast_large_row_recompute_impl(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  asc_init();
  constexpr int32_t kThreadsPerBlock = 1024;
  constexpr int32_t kReduceWarpCount = kThreadsPerBlock / 32;
  const int32_t outer_size_i32 = static_cast<int32_t>(outer_size);
  const int32_t dim_size_i32 = static_cast<int32_t>(dim_size);
  __ubuf__ scalar_t input_tile_ub[kTileElements];
  __ubuf__ outscalar_t output_tile_ub[kTileElements];
  __ubuf__ accscalar_t reduce_shared_ub[kReduceWarpCount];

  for (int32_t row = blockIdx.x; row < outer_size_i32; row += gridDim.x) {
    const int32_t row_offset = row * dim_size_i32;
    __gm__ const scalar_t* row_input = input + row_offset;
    __gm__ outscalar_t* row_output = output + row_offset;
    const uint32_t input_tile_bytes =
        static_cast<uint32_t>(dim_size_i32 * sizeof(scalar_t));
    const uint32_t output_tile_bytes =
        static_cast<uint32_t>(dim_size_i32 * sizeof(outscalar_t));
    asc_copy_gm2ub_align_sync(
        input_tile_ub,
        mutable_gm_ptr(row_input),
        input_tile_bytes);
    asc_vf_call<row_softmax_fast_large_row_forward_vf<
        scalar_t,
        accscalar_t,
        outscalar_t>>(
        dim3(kThreadsPerBlock),
        output_tile_ub,
        input_tile_ub,
        dim_size_i32,
        reduce_shared_ub);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align_sync(
        row_output,
        output_tile_ub,
        output_tile_bytes);
  }
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t, int64_t kTileElements>
__global__ __vector__ void row_softmax_fast_large_row_recompute_kernel(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y) {
  row_softmax_fast_large_row_recompute_impl<
      scalar_t,
      accscalar_t,
      outscalar_t,
      kTileElements>(output, input, outer_size, dim_size);
  (void)block_x;
  (void)block_y;
}

template <typename scalar_t, typename accscalar_t, int64_t kTileElements>
__aicore__ inline void row_softmax_fast_large_row_inplace_pipeline_impl(
    __gm__ scalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  asc_init();
  constexpr int32_t kThreadsPerBlock = 1024;
  constexpr int32_t kReduceWarpCount = kThreadsPerBlock / 32;
  const int32_t outer_size_i32 = static_cast<int32_t>(outer_size);
  const int32_t dim_size_i32 = static_cast<int32_t>(dim_size);
  __ubuf__ scalar_t row_tile_ub[2][kTileElements];
  __ubuf__ accscalar_t reduce_shared_ub[kReduceWarpCount];

  const int32_t first_row = blockIdx.x;
  if (first_row >= outer_size_i32) {
    return;
  }
  const int32_t row_count =
      ((outer_size_i32 - first_row) + gridDim.x - 1) / gridDim.x;
  const uint32_t row_bytes =
      static_cast<uint32_t>(dim_size_i32 * sizeof(scalar_t));

  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);

  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_copy_gm2ub_align(
      row_tile_ub[0],
      mutable_gm_ptr(input + first_row * dim_size_i32),
      row_bytes);
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

  for (int32_t row_idx = 0; row_idx < row_count; ++row_idx) {
    const int32_t slot = row_idx & 1;
    const int32_t event_id = slot == 0 ? EVENT_ID0 : EVENT_ID1;
    const int32_t row = first_row + row_idx * gridDim.x;

    asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);

    if (row_idx + 1 < row_count) {
      const int32_t next_slot = slot ^ 1;
      const int32_t next_event_id =
          next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
      const int32_t next_row = row + gridDim.x;

      asc_sync_wait(PIPE_MTE3, PIPE_V, next_event_id);
      asc_sync_notify(PIPE_V, PIPE_MTE2, next_event_id);
      asc_sync_wait(PIPE_V, PIPE_MTE2, next_event_id);
      asc_copy_gm2ub_align(
          row_tile_ub[next_slot],
          mutable_gm_ptr(input + next_row * dim_size_i32),
          row_bytes);
      asc_sync_notify(PIPE_MTE2, PIPE_V, next_event_id);
    }

    asc_vf_call<row_softmax_fast_large_row_forward_vf<
        scalar_t,
        accscalar_t,
        scalar_t>>(
        dim3(kThreadsPerBlock),
        row_tile_ub[slot],
        row_tile_ub[slot],
        dim_size_i32,
        reduce_shared_ub);

    asc_sync_notify(PIPE_V, PIPE_MTE3, event_id);
    asc_sync_wait(PIPE_V, PIPE_MTE3, event_id);
      asc_copy_ub2gm_align(
        output + row * dim_size_i32,
        row_tile_ub[slot],
        row_bytes);
    asc_sync_notify(PIPE_MTE3, PIPE_V, event_id);
  }

  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
}

template <typename scalar_t, typename accscalar_t, int64_t kTileElements>
__global__ __vector__ void row_softmax_fast_large_row_inplace_pipeline_kernel(
    __gm__ scalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  row_softmax_fast_large_row_inplace_pipeline_impl<
      scalar_t,
      accscalar_t,
      kTileElements>(output, input, outer_size, dim_size);
}

template <typename scalar_t, typename outscalar_t>
__simt_callee__ inline bool row_softmax_fast_use_fp16x4(int64_t dim_size) {
  return std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16> &&
      dim_size % 4 == 0;
}

template <typename scalar_t, typename outscalar_t>
__simt_callee__ inline bool row_softmax_fast_use_fp16x2(int64_t dim_size) {
  return std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16> &&
      dim_size >= 2;
}

__simt_callee__ inline int64_t row_softmax_fast_fp16x2_shift(
    int64_t row,
    int64_t dim_size) {
  return (row * dim_size) % 2;
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_callee__ inline accscalar_t row_softmax_fast_thread_max(
    __gm__ const scalar_t* row_input,
    int64_t row,
    int64_t dim_size) {
  constexpr int64_t kFastILP = 4;
  const bool use_fp16x4 = row_softmax_fast_use_fp16x4<scalar_t, outscalar_t>(dim_size);
  const bool use_fp16x2 = row_softmax_fast_use_fp16x2<scalar_t, outscalar_t>(dim_size);
  const int64_t fp16x2_shift = row_softmax_fast_fp16x2_shift(row, dim_size);

  if constexpr (
      std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16>) {
    if (use_fp16x4) {
      return fast_fp16x4_reduce<MaxFloat, accscalar_t>(
          row_input,
          dim_size,
          MaxFloat<__fp16, accscalar_t>(),
          std::numeric_limits<accscalar_t>::lowest());
    }
    if (use_fp16x2) {
      return fast_fp16x2_reduce<MaxFloat, accscalar_t>(
          row_input,
          dim_size,
          fp16x2_shift,
          MaxFloat<__fp16, accscalar_t>(),
          std::numeric_limits<accscalar_t>::lowest());
    }
  }
  return fast_ilp_reduce<
      MaxFloat,
      kFastILP,
      scalar_t,
      accscalar_t>(
      row_input,
      dim_size,
      MaxFloat<scalar_t, accscalar_t>(),
      std::numeric_limits<accscalar_t>::lowest());
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_callee__ inline accscalar_t row_softmax_fast_thread_sum(
    __gm__ const scalar_t* row_input,
    int64_t row,
    int64_t dim_size,
    accscalar_t max_input) {
  constexpr int64_t kFastILP = 4;
  const bool use_fp16x4 = row_softmax_fast_use_fp16x4<scalar_t, outscalar_t>(dim_size);
  const bool use_fp16x2 = row_softmax_fast_use_fp16x2<scalar_t, outscalar_t>(dim_size);
  const int64_t fp16x2_shift = row_softmax_fast_fp16x2_shift(row, dim_size);

  if constexpr (
      std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16>) {
    if (use_fp16x4) {
      return fast_fp16x4_reduce<SumExpfFloat, accscalar_t>(
          row_input,
          dim_size,
          SumExpfFloat<__fp16, accscalar_t>(max_input),
          static_cast<accscalar_t>(0));
    }
    if (use_fp16x2) {
      return fast_fp16x2_reduce<SumExpfFloat, accscalar_t>(
          row_input,
          dim_size,
          fp16x2_shift,
          SumExpfFloat<__fp16, accscalar_t>(max_input),
          static_cast<accscalar_t>(0));
    }
  }
  return fast_ilp_reduce<
      SumExpfFloat,
      kFastILP,
      scalar_t,
      accscalar_t>(
      row_input,
      dim_size,
      SumExpfFloat<scalar_t, accscalar_t>(max_input),
      static_cast<accscalar_t>(0));
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_callee__ inline void row_softmax_fast_write_from_gmem(
    __gm__ outscalar_t* row_output,
    __gm__ const scalar_t* row_input,
    int64_t row,
    int64_t dim_size,
    accscalar_t max_input,
    accscalar_t inv_sum) {
  constexpr int64_t kFastILP = 4;
  const bool use_fp16x4 = row_softmax_fast_use_fp16x4<scalar_t, outscalar_t>(dim_size);
  const bool use_fp16x2 = row_softmax_fast_use_fp16x2<scalar_t, outscalar_t>(dim_size);
  const int64_t fp16x2_shift = row_softmax_fast_fp16x2_shift(row, dim_size);

  if constexpr (
      std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16>) {
    if (use_fp16x4) {
      fast_fp16x4_write(
          row_output,
          row_input,
          dim_size,
          max_input,
          inv_sum);
      return;
    }
    if (use_fp16x2) {
      fast_fp16x2_write(
          row_output,
          row_input,
          dim_size,
          fp16x2_shift,
          max_input,
          inv_sum);
      return;
    }
  }
  fast_ilp_softmax_write<
      kFastILP,
      scalar_t,
      accscalar_t,
      outscalar_t>(
      row_output,
      row_input,
      dim_size,
      max_input,
      inv_sum);
}

template <typename scalar_t>
__simt_callee__ inline void row_softmax_fast_large_ub_tiled_update_running_stats(
    __ubuf__ const scalar_t* tile_ub,
    int32_t tile_idx,
    int32_t tile_elements,
    __ubuf__ float* shared,
    __ubuf__ float* running_stats) {
  constexpr int32_t kLargeRowILP = 4;
  float thread_max = std::numeric_limits<float>::lowest();
  if constexpr (std::is_same_v<scalar_t, __fp16>) {
    __ubuf__ const half2* vector_tile =
        reinterpret_cast<__ubuf__ const half2*>(tile_ub);
    const int32_t half2_size = tile_elements / 2;
    const int32_t quad_half2_size = half2_size & ~3;
    for (int32_t pair_offset = threadIdx.x * 4; pair_offset < quad_half2_size;
         pair_offset += blockDim.x * 4) {
      const half2 first_pair = vector_tile[pair_offset];
      thread_max = Max<float>()(thread_max, __low2float(first_pair));
      thread_max = Max<float>()(thread_max, __high2float(first_pair));
      const half2 second_pair = vector_tile[pair_offset + 1];
      thread_max = Max<float>()(thread_max, __low2float(second_pair));
      thread_max = Max<float>()(thread_max, __high2float(second_pair));
      const half2 third_pair = vector_tile[pair_offset + 2];
      thread_max = Max<float>()(thread_max, __low2float(third_pair));
      thread_max = Max<float>()(thread_max, __high2float(third_pair));
      const half2 fourth_pair = vector_tile[pair_offset + 3];
      thread_max = Max<float>()(thread_max, __low2float(fourth_pair));
      thread_max = Max<float>()(thread_max, __high2float(fourth_pair));
    }
    if ((half2_size & 3) != 0 && threadIdx.x == 0) {
      for (int32_t tail_offset = quad_half2_size; tail_offset < half2_size;
           ++tail_offset) {
        const half2 tail_pair = vector_tile[tail_offset];
        thread_max = Max<float>()(thread_max, __low2float(tail_pair));
        thread_max = Max<float>()(thread_max, __high2float(tail_pair));
      }
    }
    if ((tile_elements % 2) != 0 && threadIdx.x == 0) {
      thread_max = Max<float>()(
          thread_max,
          static_cast<float>(tile_ub[tile_elements - 1]));
    }
  } else {
    for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_elements;
         offset += blockDim.x * kLargeRowILP) {
#pragma unroll
      for (int32_t i = 0; i < kLargeRowILP; ++i) {
        const int32_t element_offset = offset + i;
        if (element_offset < tile_elements) {
          thread_max = Max<float>()(
              thread_max,
              static_cast<float>(tile_ub[element_offset]));
        }
      }
    }
  }
  const float tile_max = fast_block_reduce_warp<float, Max>(
      shared,
      thread_max,
      std::numeric_limits<float>::lowest());

  float thread_sum = 0.0f;
  if constexpr (std::is_same_v<scalar_t, __fp16>) {
    __ubuf__ const half2* vector_tile =
        reinterpret_cast<__ubuf__ const half2*>(tile_ub);
    const int32_t half2_size = tile_elements / 2;
    const int32_t quad_half2_size = half2_size & ~3;
    for (int32_t pair_offset = threadIdx.x * 4; pair_offset < quad_half2_size;
         pair_offset += blockDim.x * 4) {
      const half2 first_pair = vector_tile[pair_offset];
      thread_sum += __expf(__low2float(first_pair) - tile_max);
      thread_sum += __expf(__high2float(first_pair) - tile_max);
      const half2 second_pair = vector_tile[pair_offset + 1];
      thread_sum += __expf(__low2float(second_pair) - tile_max);
      thread_sum += __expf(__high2float(second_pair) - tile_max);
      const half2 third_pair = vector_tile[pair_offset + 2];
      thread_sum += __expf(__low2float(third_pair) - tile_max);
      thread_sum += __expf(__high2float(third_pair) - tile_max);
      const half2 fourth_pair = vector_tile[pair_offset + 3];
      thread_sum += __expf(__low2float(fourth_pair) - tile_max);
      thread_sum += __expf(__high2float(fourth_pair) - tile_max);
    }
    if ((half2_size & 3) != 0 && threadIdx.x == 0) {
      for (int32_t tail_offset = quad_half2_size; tail_offset < half2_size;
           ++tail_offset) {
        const half2 tail_pair = vector_tile[tail_offset];
        thread_sum += __expf(__low2float(tail_pair) - tile_max);
        thread_sum += __expf(__high2float(tail_pair) - tile_max);
      }
    }
    if ((tile_elements % 2) != 0 && threadIdx.x == 0) {
      thread_sum += __expf(
          static_cast<float>(tile_ub[tile_elements - 1]) - tile_max);
    }
  } else {
    for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_elements;
         offset += blockDim.x * kLargeRowILP) {
#pragma unroll
      for (int32_t i = 0; i < kLargeRowILP; ++i) {
        const int32_t element_offset = offset + i;
        if (element_offset < tile_elements) {
          thread_sum +=
              __expf(static_cast<float>(tile_ub[element_offset]) - tile_max);
        }
      }
    }
  }
  const float tile_sum = fast_block_reduce_warp<float, Add>(
      shared,
      thread_sum,
      0.0f);

  if (threadIdx.x == 0) {
    float combined_max = tile_max;
    float combined_sum = tile_sum;
    if (tile_idx != 0) {
      const float previous_max = running_stats[0];
      const float previous_sum = running_stats[1];
      // Merge stable per-tile softmax states without rescanning earlier tiles.
      combined_max = Max<float>()(previous_max, tile_max);
      combined_sum =
          previous_sum * __expf(previous_max - combined_max) +
          tile_sum * __expf(tile_max - combined_max);
    }
    running_stats[0] = combined_max;
    running_stats[1] = combined_sum;
  }
}

template <typename scalar_t>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_large_ub_tiled_stats_vf(
    __ubuf__ const scalar_t* tile_ub,
    __gm__ float* row_max,
    __gm__ float* row_inv_sum,
    int32_t row,
    int32_t tile_idx,
    int32_t tile_count,
    int32_t tile_elements,
    __ubuf__ float* shared,
    __ubuf__ float* running_stats) {
  row_softmax_fast_large_ub_tiled_update_running_stats<scalar_t>(
      tile_ub,
      tile_idx,
      tile_elements,
      shared,
      running_stats);
  if (threadIdx.x == 0 && tile_idx + 1 == tile_count) {
    row_max[row] = running_stats[0];
    row_inv_sum[row] = 1.0f / running_stats[1];
  }
}

template <typename scalar_t>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_large_ub_tiled_local_stats_vf(
    __ubuf__ const scalar_t* tile_ub,
    int32_t tile_idx,
    int32_t tile_elements,
    __ubuf__ float* shared,
    __ubuf__ float* running_stats) {
  row_softmax_fast_large_ub_tiled_update_running_stats<scalar_t>(
      tile_ub,
      tile_idx,
      tile_elements,
      shared,
      running_stats);
}

template <typename scalar_t>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_large_ub_tiled_write_vf(
    __ubuf__ scalar_t* tile_ub,
    __gm__ const float* row_max,
    __gm__ const float* row_inv_sum,
    int32_t row,
    int32_t tile_elements) {
  const float max_input = row_max[row];
  const float inv_sum = row_inv_sum[row];
  if constexpr (std::is_same_v<scalar_t, __fp16>) {
    __ubuf__ half2* vector_tile = (__ubuf__ half2*)tile_ub;
    const int32_t half2_size = tile_elements / 2;

    if ((tile_elements % 4) == 0) {
      for (int32_t pair_offset = threadIdx.x * 2; pair_offset < half2_size;
           pair_offset += blockDim.x * 2) {
        const half2 first_pair = vector_tile[pair_offset];
        vector_tile[pair_offset] = __floats2half2_rn(
            __expf(__low2float(first_pair) - max_input) * inv_sum,
            __expf(__high2float(first_pair) - max_input) * inv_sum);

        const half2 second_pair = vector_tile[pair_offset + 1];
        vector_tile[pair_offset + 1] = __floats2half2_rn(
            __expf(__low2float(second_pair) - max_input) * inv_sum,
            __expf(__high2float(second_pair) - max_input) * inv_sum);
      }
      return;
    }

    for (int32_t pair_offset = threadIdx.x; pair_offset < half2_size;
         pair_offset += blockDim.x) {
      const half2 pair = vector_tile[pair_offset];
      vector_tile[pair_offset] = __floats2half2_rn(
          __expf(__low2float(pair) - max_input) * inv_sum,
          __expf(__high2float(pair) - max_input) * inv_sum);
    }
    if ((tile_elements % 2) != 0 && threadIdx.x == 0) {
      tile_ub[tile_elements - 1] = static_cast<scalar_t>(
          __expf(static_cast<float>(tile_ub[tile_elements - 1]) - max_input) *
          inv_sum);
    }
    return;
  }

  constexpr int32_t kLargeRowILP = 4;
  for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_elements;
       offset += blockDim.x * kLargeRowILP) {
#pragma unroll
    for (int32_t i = 0; i < kLargeRowILP; ++i) {
      const int32_t element_offset = offset + i;
      if (element_offset < tile_elements) {
        tile_ub[element_offset] = static_cast<scalar_t>(
            __expf(static_cast<float>(tile_ub[element_offset]) - max_input) *
            inv_sum);
      }
    }
  }
}

template <typename scalar_t>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_large_ub_tiled_write_local_stats_vf(
    __ubuf__ scalar_t* tile_ub,
    __ubuf__ const float* running_stats,
    int32_t tile_elements) {
  const float max_input = running_stats[0];
  const float inv_sum = 1.0f / running_stats[1];
  if constexpr (std::is_same_v<scalar_t, __fp16>) {
    __ubuf__ half2* vector_tile = (__ubuf__ half2*)tile_ub;
    const int32_t half2_size = tile_elements / 2;

    if ((tile_elements % 4) == 0) {
      for (int32_t pair_offset = threadIdx.x * 2; pair_offset < half2_size;
           pair_offset += blockDim.x * 2) {
        const half2 first_pair = vector_tile[pair_offset];
        vector_tile[pair_offset] = __floats2half2_rn(
            __expf(__low2float(first_pair) - max_input) * inv_sum,
            __expf(__high2float(first_pair) - max_input) * inv_sum);

        const half2 second_pair = vector_tile[pair_offset + 1];
        vector_tile[pair_offset + 1] = __floats2half2_rn(
            __expf(__low2float(second_pair) - max_input) * inv_sum,
            __expf(__high2float(second_pair) - max_input) * inv_sum);
      }
      return;
    }

    for (int32_t pair_offset = threadIdx.x; pair_offset < half2_size;
         pair_offset += blockDim.x) {
      const half2 pair = vector_tile[pair_offset];
      vector_tile[pair_offset] = __floats2half2_rn(
          __expf(__low2float(pair) - max_input) * inv_sum,
          __expf(__high2float(pair) - max_input) * inv_sum);
    }
    if ((tile_elements % 2) != 0 && threadIdx.x == 0) {
      tile_ub[tile_elements - 1] = static_cast<scalar_t>(
          __expf(static_cast<float>(tile_ub[tile_elements - 1]) - max_input) *
          inv_sum);
    }
    return;
  }

  constexpr int32_t kLargeRowILP = 4;
  for (int32_t offset = threadIdx.x * kLargeRowILP; offset < tile_elements;
       offset += blockDim.x * kLargeRowILP) {
#pragma unroll
    for (int32_t i = 0; i < kLargeRowILP; ++i) {
      const int32_t element_offset = offset + i;
      if (element_offset < tile_elements) {
        tile_ub[element_offset] = static_cast<scalar_t>(
            __expf(static_cast<float>(tile_ub[element_offset]) - max_input) *
            inv_sum);
      }
    }
  }
}

template <typename scalar_t, int64_t kTileElements>
__aicore__ inline void row_softmax_fast_large_ub_tiled_stats_pipeline_impl(
    __gm__ const scalar_t* input,
    __gm__ float* row_max,
    __gm__ float* row_inv_sum,
    int64_t outer_size,
    int64_t dim_size) {
  asc_init();
  constexpr int32_t kThreadsPerBlock = 1024;
  constexpr int32_t kReduceWarpCount = kThreadsPerBlock / 32;
  const int32_t outer_size_i32 = static_cast<int32_t>(outer_size);
  const int32_t dim_size_i32 = static_cast<int32_t>(dim_size);
  constexpr int32_t kTileElementsI32 = static_cast<int32_t>(kTileElements);
  __ubuf__ scalar_t row_tile_ub[2][kTileElements];
  __ubuf__ float reduce_shared_ub[kReduceWarpCount];
  __ubuf__ float running_stats_ub[2];
  static_assert(
      2 * kTileElements * sizeof(scalar_t) +
          kReduceWarpCount * sizeof(float) + 2 * sizeof(float) <=
          kUsableUbBytes,
      "large-row stats pipeline exceeds the 224 KiB UB budget");

  const int32_t first_row = blockIdx.x;
  if (first_row >= outer_size_i32) {
    return;
  }
  const int32_t row_count =
      ((outer_size_i32 - first_row) + gridDim.x - 1) / gridDim.x;
  const int32_t tile_count =
      (dim_size_i32 + kTileElementsI32 - 1) / kTileElementsI32;

  asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID1);
  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_copy_gm2ub_align(
      row_tile_ub[0],
      mutable_gm_ptr(input + first_row * dim_size_i32),
      static_cast<uint32_t>(kTileElements * sizeof(scalar_t)));
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

  int32_t sequence_idx = 0;
  for (int32_t row_idx = 0; row_idx < row_count; ++row_idx) {
    const int32_t row = first_row + row_idx * gridDim.x;
    for (int32_t tile_idx = 0; tile_idx < tile_count; ++tile_idx) {
      const int32_t slot = sequence_idx & 1;
      const int32_t event_id = slot == 0 ? EVENT_ID0 : EVENT_ID1;
      const int32_t tile_offset = tile_idx * kTileElementsI32;
      const int32_t remaining_elements = dim_size_i32 - tile_offset;
      const int32_t tile_elements = remaining_elements < kTileElementsI32
          ? remaining_elements
          : kTileElementsI32;

      asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);
      asc_vf_call<row_softmax_fast_large_ub_tiled_stats_vf<scalar_t>>(
          dim3(kThreadsPerBlock),
          row_tile_ub[slot],
          row_max,
          row_inv_sum,
          row,
          tile_idx,
          tile_count,
          tile_elements,
          reduce_shared_ub,
          running_stats_ub);
      asc_sync_notify(PIPE_V, PIPE_MTE2, event_id);
      ++sequence_idx;

      const bool has_next_tile = tile_idx + 1 < tile_count;
      const bool has_next_row = row_idx + 1 < row_count;
      if (has_next_tile || has_next_row) {
        const int32_t next_slot = sequence_idx & 1;
        const int32_t next_event_id =
            next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
        const int32_t next_row = has_next_tile ? row : row + gridDim.x;
        const int32_t next_tile_idx = has_next_tile ? tile_idx + 1 : 0;
        const int32_t next_tile_offset = next_tile_idx * kTileElementsI32;
        const int32_t next_remaining_elements = dim_size_i32 - next_tile_offset;
        const int32_t next_tile_elements = next_remaining_elements < kTileElementsI32
            ? next_remaining_elements
            : kTileElementsI32;

        asc_sync_wait(PIPE_V, PIPE_MTE2, next_event_id);
        asc_copy_gm2ub_align(
            row_tile_ub[next_slot],
            mutable_gm_ptr(
                input + next_row * dim_size_i32 + next_tile_offset),
            static_cast<uint32_t>(next_tile_elements * sizeof(scalar_t)));
        asc_sync_notify(PIPE_MTE2, PIPE_V, next_event_id);
      }
    }
  }

  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID1);
}

template <typename scalar_t, int64_t kTileElements>
__global__ __vector__ void row_softmax_fast_large_ub_tiled_stats_pipeline_kernel(
    __gm__ const scalar_t* input,
    __gm__ float* row_max,
    __gm__ float* row_inv_sum,
    int64_t outer_size,
    int64_t dim_size) {
  row_softmax_fast_large_ub_tiled_stats_pipeline_impl<
      scalar_t,
      kTileElements>(
      input,
      row_max,
      row_inv_sum,
      outer_size,
      dim_size);
}

template <typename scalar_t, int64_t kTileElements>
__aicore__ inline void row_softmax_fast_large_ub_tiled_write_pipeline_impl(
    __gm__ scalar_t* output,
    __gm__ const scalar_t* input,
    __gm__ const float* row_max,
    __gm__ const float* row_inv_sum,
    int64_t outer_size,
    int64_t dim_size) {
  asc_init();
  constexpr int32_t kThreadsPerBlock = 1024;
  const int32_t outer_size_i32 = static_cast<int32_t>(outer_size);
  const int32_t dim_size_i32 = static_cast<int32_t>(dim_size);
  constexpr int32_t kTileElementsI32 = static_cast<int32_t>(kTileElements);
  __ubuf__ scalar_t row_tile_ub[2][kTileElements];
  static_assert(
      2 * kTileElements * sizeof(scalar_t) <= kUsableUbBytes,
      "large-row write pipeline exceeds the 224 KiB UB budget");

  const int32_t first_row = blockIdx.x;
  if (first_row >= outer_size_i32) {
    return;
  }
  const int32_t row_count =
      ((outer_size_i32 - first_row) + gridDim.x - 1) / gridDim.x;
  const int32_t tile_count =
      (dim_size_i32 + kTileElementsI32 - 1) / kTileElementsI32;

  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);

  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
  asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
  const int32_t first_tile_elements = dim_size_i32 < kTileElementsI32
      ? dim_size_i32
      : kTileElementsI32;
  asc_copy_gm2ub_align(
      row_tile_ub[0],
      mutable_gm_ptr(input + first_row * dim_size_i32),
      static_cast<uint32_t>(first_tile_elements * sizeof(scalar_t)));
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

  int32_t sequence_idx = 0;
  for (int32_t row_idx = 0; row_idx < row_count; ++row_idx) {
    const int32_t row = first_row + row_idx * gridDim.x;
    for (int32_t tile_idx = 0; tile_idx < tile_count; ++tile_idx) {
      const int32_t slot = sequence_idx & 1;
      const int32_t event_id = slot == 0 ? EVENT_ID0 : EVENT_ID1;
      const int32_t tile_offset = tile_idx * kTileElementsI32;
      const int32_t remaining_elements = dim_size_i32 - tile_offset;
      const int32_t tile_elements = remaining_elements < kTileElementsI32
          ? remaining_elements
          : kTileElementsI32;

      asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);

      const bool has_next_tile = tile_idx + 1 < tile_count;
      const bool has_next_row = row_idx + 1 < row_count;
      if (has_next_tile || has_next_row) {
        const int32_t next_sequence_idx = sequence_idx + 1;
        const int32_t next_slot = next_sequence_idx & 1;
        const int32_t next_event_id =
            next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
        const int32_t next_row = has_next_tile ? row : row + gridDim.x;
        const int32_t next_tile_idx = has_next_tile ? tile_idx + 1 : 0;
        const int32_t next_tile_offset = next_tile_idx * kTileElementsI32;
        const int32_t next_remaining_elements = dim_size_i32 - next_tile_offset;
        const int32_t next_tile_elements = next_remaining_elements < kTileElementsI32
            ? next_remaining_elements
            : kTileElementsI32;

        asc_sync_wait(PIPE_MTE3, PIPE_V, next_event_id);
        asc_sync_notify(PIPE_V, PIPE_MTE2, next_event_id);
        asc_sync_wait(PIPE_V, PIPE_MTE2, next_event_id);
        asc_copy_gm2ub_align(
            row_tile_ub[next_slot],
            mutable_gm_ptr(
                input + next_row * dim_size_i32 + next_tile_offset),
            static_cast<uint32_t>(next_tile_elements * sizeof(scalar_t)));
        asc_sync_notify(PIPE_MTE2, PIPE_V, next_event_id);
      }

      asc_vf_call<row_softmax_fast_large_ub_tiled_write_vf<scalar_t>>(
          dim3(kThreadsPerBlock),
          row_tile_ub[slot],
          row_max,
          row_inv_sum,
          row,
          tile_elements);
      asc_sync_notify(PIPE_V, PIPE_MTE3, event_id);
      asc_sync_wait(PIPE_V, PIPE_MTE3, event_id);
    asc_copy_ub2gm_align(
          output + row * dim_size_i32 + tile_offset,
          row_tile_ub[slot],
          static_cast<uint32_t>(tile_elements * sizeof(scalar_t)));
      asc_sync_notify(PIPE_MTE3, PIPE_V, event_id);
      ++sequence_idx;
    }
  }

  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
  asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
}

template <typename scalar_t, int64_t kTileElements>
__global__ __vector__ void row_softmax_fast_large_ub_tiled_write_pipeline_kernel(
    __gm__ scalar_t* output,
    __gm__ const scalar_t* input,
    __gm__ const float* row_max,
    __gm__ const float* row_inv_sum,
    int64_t outer_size,
    int64_t dim_size) {
  row_softmax_fast_large_ub_tiled_write_pipeline_impl<
      scalar_t,
      kTileElements>(
      output,
      input,
      row_max,
      row_inv_sum,
      outer_size,
      dim_size);
}

template <typename scalar_t, int64_t kTileElements>
__aicore__ inline void row_softmax_fast_large_ub_tiled_fused_pipeline_impl(
    __gm__ scalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  asc_init();
  constexpr int32_t kThreadsPerBlock = 1024;
  constexpr int32_t kReduceWarpCount = kThreadsPerBlock / 32;
  const int32_t outer_size_i32 = static_cast<int32_t>(outer_size);
  const int32_t dim_size_i32 = static_cast<int32_t>(dim_size);
  constexpr int32_t kTileElementsI32 = static_cast<int32_t>(kTileElements);
  __ubuf__ scalar_t row_tile_ub[2][kTileElements];
  __ubuf__ float reduce_shared_ub[kReduceWarpCount];
  __ubuf__ float running_stats_ub[2];
  static_assert(
      2 * kTileElements * sizeof(scalar_t) +
          kReduceWarpCount * sizeof(float) + 2 * sizeof(float) <=
          kUsableUbBytes,
      "large-row fused pipeline exceeds the 224 KiB UB budget");

  const int32_t first_row = blockIdx.x;
  if (first_row >= outer_size_i32) {
    return;
  }
  const int32_t row_count =
      ((outer_size_i32 - first_row) + gridDim.x - 1) / gridDim.x;
  const int32_t tile_count =
      (dim_size_i32 + kTileElementsI32 - 1) / kTileElementsI32;

  for (int32_t row_idx = 0; row_idx < row_count; ++row_idx) {
    const int32_t row = first_row + row_idx * gridDim.x;

    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID1);
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
    const int32_t first_stats_tile_idx = tile_count - 1;
    const int32_t first_stats_tile_offset =
        first_stats_tile_idx * kTileElementsI32;
    const int32_t first_stats_tile_elements =
        dim_size_i32 - first_stats_tile_offset;
    asc_copy_gm2ub_align(
        row_tile_ub[0],
        mutable_gm_ptr(input + row * dim_size_i32 + first_stats_tile_offset),
        static_cast<uint32_t>(first_stats_tile_elements * sizeof(scalar_t)));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

    for (int32_t stats_iter = 0; stats_iter < tile_count; ++stats_iter) {
      const int32_t stats_tile_idx = stats_iter == 0
          ? tile_count - 1
          : stats_iter - 1;
      const int32_t slot = stats_iter & 1;
      const int32_t event_id = slot == 0 ? EVENT_ID0 : EVENT_ID1;
      const int32_t tile_offset = stats_tile_idx * kTileElementsI32;
      const int32_t remaining_elements = dim_size_i32 - tile_offset;
      const int32_t tile_elements = remaining_elements < kTileElementsI32
          ? remaining_elements
          : kTileElementsI32;

      asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);
      asc_vf_call<row_softmax_fast_large_ub_tiled_local_stats_vf<scalar_t>>(
          dim3(kThreadsPerBlock),
          row_tile_ub[slot],
          stats_iter,
          tile_elements,
          reduce_shared_ub,
          running_stats_ub);
      asc_sync_notify(PIPE_V, PIPE_MTE2, event_id);

      if (stats_iter + 1 < tile_count) {
        const int32_t next_stats_iter = stats_iter + 1;
        const int32_t next_stats_tile_idx = next_stats_iter - 1;
        const int32_t next_slot = next_stats_iter & 1;
        const int32_t next_event_id =
            next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
        const int32_t next_tile_offset = next_stats_tile_idx * kTileElementsI32;
        const int32_t next_remaining_elements = dim_size_i32 - next_tile_offset;
        const int32_t next_tile_elements = next_remaining_elements < kTileElementsI32
            ? next_remaining_elements
            : kTileElementsI32;

        asc_sync_wait(PIPE_V, PIPE_MTE2, next_event_id);
        asc_copy_gm2ub_align(
            row_tile_ub[next_slot],
            mutable_gm_ptr(input + row * dim_size_i32 + next_tile_offset),
            static_cast<uint32_t>(next_tile_elements * sizeof(scalar_t)));
        asc_sync_notify(PIPE_MTE2, PIPE_V, next_event_id);
      }
    }

    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID1);

    const int32_t retained_tile_idx = tile_count - 2;
    const int32_t retained_slot = (tile_count - 1) & 1;
    const int32_t retained_event_id =
        retained_slot == 0 ? EVENT_ID0 : EVENT_ID1;
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);
    asc_sync_wait(PIPE_MTE3, PIPE_V, retained_event_id);
    asc_vf_call<row_softmax_fast_large_ub_tiled_write_local_stats_vf<scalar_t>>(
        dim3(kThreadsPerBlock),
        row_tile_ub[retained_slot],
        running_stats_ub,
        kTileElements);
    asc_sync_notify(PIPE_V, PIPE_MTE3, retained_event_id);
    asc_sync_wait(PIPE_V, PIPE_MTE3, retained_event_id);
    asc_copy_ub2gm_align(
        output + row * dim_size_i32 + retained_tile_idx * kTileElementsI32,
        row_tile_ub[retained_slot],
        static_cast<uint32_t>(kTileElements * sizeof(scalar_t)));
    asc_sync_notify(PIPE_MTE3, PIPE_V, retained_event_id);

    const int32_t remaining_write_count = tile_count - 1;
    const int32_t first_write_tile_idx = tile_count - 1;
    const int32_t first_write_tile_offset =
        first_write_tile_idx * kTileElementsI32;
    const int32_t first_write_tile_elements =
        dim_size_i32 - first_write_tile_offset;
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_copy_gm2ub_align(
        row_tile_ub[0],
        mutable_gm_ptr(input + row * dim_size_i32 + first_write_tile_offset),
        static_cast<uint32_t>(first_write_tile_elements * sizeof(scalar_t)));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);

    for (int32_t write_iter = 0;
         write_iter < remaining_write_count;
         ++write_iter) {
      const int32_t write_tile_idx = write_iter == 0
          ? tile_count - 1
          : write_iter - 1;
      const int32_t slot = write_iter & 1;
      const int32_t event_id = slot == 0 ? EVENT_ID0 : EVENT_ID1;
      const int32_t tile_offset = write_tile_idx * kTileElementsI32;
      const int32_t remaining_elements = dim_size_i32 - tile_offset;
      const int32_t tile_elements = remaining_elements < kTileElementsI32
          ? remaining_elements
          : kTileElementsI32;

      asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);

      if (write_iter + 1 < remaining_write_count) {
        const int32_t next_write_iter = write_iter + 1;
        const int32_t next_write_tile_idx = next_write_iter - 1;
        const int32_t next_slot = next_write_iter & 1;
        const int32_t next_event_id =
            next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
        const int32_t next_tile_offset = next_write_tile_idx * kTileElementsI32;
        const int32_t next_remaining_elements = dim_size_i32 - next_tile_offset;
        const int32_t next_tile_elements = next_remaining_elements < kTileElementsI32
            ? next_remaining_elements
            : kTileElementsI32;

        asc_sync_wait(PIPE_MTE3, PIPE_V, next_event_id);
        asc_sync_notify(PIPE_V, PIPE_MTE2, next_event_id);
        asc_sync_wait(PIPE_V, PIPE_MTE2, next_event_id);
        asc_copy_gm2ub_align(
            row_tile_ub[next_slot],
            mutable_gm_ptr(input + row * dim_size_i32 + next_tile_offset),
            static_cast<uint32_t>(next_tile_elements * sizeof(scalar_t)));
        asc_sync_notify(PIPE_MTE2, PIPE_V, next_event_id);
      }

      asc_vf_call<row_softmax_fast_large_ub_tiled_write_local_stats_vf<scalar_t>>(
          dim3(kThreadsPerBlock),
          row_tile_ub[slot],
          running_stats_ub,
          tile_elements);
      asc_sync_notify(PIPE_V, PIPE_MTE3, event_id);
      asc_sync_wait(PIPE_V, PIPE_MTE3, event_id);
      asc_copy_ub2gm_align(
          output + row * dim_size_i32 + tile_offset,
          row_tile_ub[slot],
          static_cast<uint32_t>(tile_elements * sizeof(scalar_t)));
      asc_sync_notify(PIPE_MTE3, PIPE_V, event_id);
    }

    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
  }
}

template <typename scalar_t, int64_t kTileElements>
__global__ __vector__ void row_softmax_fast_large_ub_tiled_fused_pipeline_kernel(
    __gm__ scalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size) {
  row_softmax_fast_large_ub_tiled_fused_pipeline_impl<
      scalar_t,
      kTileElements>(
      output,
      input,
      outer_size,
      dim_size);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_forward_vf(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size,
    __ubuf__ uint32_t* dynamicStartUB) {
  auto shared = (__ubuf__ accscalar_t*)dynamicStartUB;

  for (int64_t row = blockIdx.x; row < outer_size; row += gridDim.x) {
    __gm__ const scalar_t* row_input = input + row * dim_size;
    __gm__ outscalar_t* row_output = output + row * dim_size;
    const accscalar_t thread_max =
        row_softmax_fast_thread_max<scalar_t, accscalar_t, outscalar_t>(
            row_input,
            row,
            dim_size);
    const accscalar_t max_input = fast_block_reduce_warp<accscalar_t, Max>(
        shared,
        thread_max,
        std::numeric_limits<accscalar_t>::lowest());

    const accscalar_t thread_exp =
        row_softmax_fast_thread_sum<scalar_t, accscalar_t, outscalar_t>(
            row_input,
            row,
            dim_size,
            max_input);
    const accscalar_t inv_sum = fast_block_reduce_warp_inverse<accscalar_t, Add>(
        shared,
        thread_exp,
        static_cast<accscalar_t>(0));
    row_softmax_fast_write_from_gmem<scalar_t, accscalar_t, outscalar_t>(
        row_output,
        row_input,
        row,
        dim_size,
        max_input,
        inv_sum);
  }
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t, int64_t kRegCount>
__simt_vf__ __launch_bounds__(1024) inline void row_softmax_fast_reg_forward_vf(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size,
    __ubuf__ uint32_t* dynamicStartUB) {
  auto shared = (__ubuf__ accscalar_t*)dynamicStartUB;

  for (int64_t row = blockIdx.x; row < outer_size; row += gridDim.x) {
    __gm__ const scalar_t* row_input = input + row * dim_size;
    __gm__ outscalar_t* row_output = output + row * dim_size;
    scalar_t elements[kRegCount];

    accscalar_t thread_max = std::numeric_limits<accscalar_t>::lowest();
#pragma unroll
    for (int64_t reg_idx = 0; reg_idx < kRegCount; ++reg_idx) {
      const int64_t offset = threadIdx.x + reg_idx * blockDim.x;
      if (offset < dim_size) {
        elements[reg_idx] = row_input[offset];
        thread_max = Max<accscalar_t>()(
            thread_max,
            static_cast<accscalar_t>(elements[reg_idx]));
      }
    }
    const accscalar_t max_input = fast_block_reduce_warp<accscalar_t, Max>(
        shared,
        thread_max,
        std::numeric_limits<accscalar_t>::lowest());

    accscalar_t thread_exp = static_cast<accscalar_t>(0);
#pragma unroll
    for (int64_t reg_idx = 0; reg_idx < kRegCount; ++reg_idx) {
      const int64_t offset = threadIdx.x + reg_idx * blockDim.x;
      if (offset < dim_size) {
        thread_exp += __expf(
            static_cast<accscalar_t>(elements[reg_idx]) - max_input);
      }
    }
    const accscalar_t sum = fast_block_reduce_warp<accscalar_t, Add>(
        shared,
        thread_exp,
        static_cast<accscalar_t>(0));

#pragma unroll
    for (int64_t reg_idx = 0; reg_idx < kRegCount; ++reg_idx) {
      const int64_t offset = threadIdx.x + reg_idx * blockDim.x;
      if (offset < dim_size) {
        row_output[offset] = static_cast<outscalar_t>(
            __expf(static_cast<accscalar_t>(elements[reg_idx]) - max_input) / sum);
      }
    }
  }
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
__global__ __vector__ void row_softmax_fast_forward_kernel(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_vf_call<row_softmax_fast_forward_vf<scalar_t, accscalar_t, outscalar_t>>(
      dim3(block_x, block_y),
      output,
      input,
      outer_size,
      dim_size,
      dynamicStartUB);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t, int64_t kRegCount>
__global__ __vector__ void row_softmax_fast_reg_forward_kernel(
    __gm__ outscalar_t* output,
    __gm__ const scalar_t* input,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y) {
  extern __ubuf__ uint32_t dynamicStartUB[];
  asc_vf_call<row_softmax_fast_reg_forward_vf<
      scalar_t,
      accscalar_t,
      outscalar_t,
      kRegCount>>(
      dim3(block_x, block_y),
      output,
      input,
      outer_size,
      dim_size,
      dynamicStartUB);
}

inline int64_t row_softmax_fast_register_count(
    int64_t dim_size,
    int64_t block_x) {
  return (dim_size + block_x - 1) / block_x;
}

inline bool use_register_like_row_softmax_fast(
    int64_t dim_size,
    int64_t block_x) {
  const int64_t register_count =
      row_softmax_fast_register_count(dim_size, block_x);
  return register_count > 1 && register_count <= 8;
}

template <typename scalar_t, typename outscalar_t>
inline bool use_large_row_recompute_row_softmax_fast(int64_t dim_size) {
  constexpr bool kFp16Path =
      std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16>;
  constexpr int64_t kMaxWholeRowElements = kFp16Path
      ? kLargeRowFp16TileElements
      : kLargeRowFp32TileElements;
  return dim_size >= 8192 && dim_size <= kMaxWholeRowElements;
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t, int64_t kTileElements>
void launch_row_fast_large_recompute_forward_kernel(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    void* acl_stream) {
  row_softmax_fast_large_row_recompute_kernel<
      scalar_t,
      accscalar_t,
      outscalar_t,
      kTileElements>
      <<<grid_x, 0, acl_stream>>>(
          output_ptr,
          input_ptr,
          outer_size,
          dim_size,
          block_x,
          block_y);
}

template <typename scalar_t, typename accscalar_t, int64_t kTileElements>
void launch_row_fast_large_inplace_pipeline_forward_kernel(
    const scalar_t* input_ptr,
    scalar_t* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t grid_x,
    void* acl_stream) {
  constexpr int64_t kPipelinePhysicalGridXLimit = 64;
  const int64_t pipeline_grid_x = grid_x < kPipelinePhysicalGridXLimit
      ? grid_x
      : kPipelinePhysicalGridXLimit;
  row_softmax_fast_large_row_inplace_pipeline_kernel<
      scalar_t,
      accscalar_t,
      kTileElements>
      <<<pipeline_grid_x, 0, acl_stream>>>(
          output_ptr,
          input_ptr,
          outer_size,
          dim_size);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
void launch_row_fast_large_tiled_forward_kernel(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    accscalar_t* row_max_ptr,
    accscalar_t* row_inv_sum_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  static_assert(
      std::is_same_v<scalar_t, outscalar_t>,
      "large-row tiled pipeline requires matching input and output dtypes");
  static_assert(
      std::is_same_v<accscalar_t, float>,
      "large-row tiled pipeline stores float row statistics");
  constexpr int64_t kTileElements = std::is_same_v<scalar_t, __fp16>
      ? kLargeRowFp16TileElements
      : kLargeRowFp32TileElements;
  constexpr int64_t kPhysicalGridXLimit = 64;
  const int64_t pipeline_grid_x = grid_x < kPhysicalGridXLimit
      ? grid_x
      : kPhysicalGridXLimit;

  if constexpr (
      std::is_same_v<scalar_t, __fp16> &&
      std::is_same_v<outscalar_t, __fp16>) {
    row_softmax_fast_large_ub_tiled_fused_pipeline_kernel<
        scalar_t,
        kTileElements>
        <<<pipeline_grid_x, 0, acl_stream>>>(
            output_ptr,
            input_ptr,
            outer_size,
            dim_size);
    (void)row_max_ptr;
    (void)row_inv_sum_ptr;
    (void)block_x;
    (void)block_y;
    (void)dynamic_ubuf_bytes;
    return;
  }

  row_softmax_fast_large_ub_tiled_stats_pipeline_kernel<
      scalar_t,
      kTileElements>
      <<<pipeline_grid_x, 0, acl_stream>>>(
          input_ptr,
          reinterpret_cast<float*>(row_max_ptr),
          reinterpret_cast<float*>(row_inv_sum_ptr),
          outer_size,
          dim_size);
  row_softmax_fast_large_ub_tiled_write_pipeline_kernel<
      scalar_t,
      kTileElements>
      <<<pipeline_grid_x, 0, acl_stream>>>(
          output_ptr,
          input_ptr,
          reinterpret_cast<const float*>(row_max_ptr),
          reinterpret_cast<const float*>(row_inv_sum_ptr),
          outer_size,
          dim_size);
  (void)block_x;
  (void)block_y;
  (void)dynamic_ubuf_bytes;
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t, int64_t kRegCount>
void launch_row_fast_reg_forward_kernel(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  row_softmax_fast_reg_forward_kernel<
      scalar_t,
      accscalar_t,
      outscalar_t,
      kRegCount>
      <<<grid_x, dynamic_ubuf_bytes, acl_stream>>>(
          output_ptr,
          input_ptr,
          outer_size,
          dim_size,
          block_x,
          block_y);
}

template <typename scalar_t, typename accscalar_t, typename outscalar_t>
void dispatch_row_fast_forward_kernel_impl(
    const scalar_t* input_ptr,
    outscalar_t* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  if (use_large_row_recompute_row_softmax_fast<scalar_t, outscalar_t>(dim_size)) {
    if constexpr (
        std::is_same_v<scalar_t, __fp16> &&
        std::is_same_v<outscalar_t, __fp16>) {
      if (dim_size <= 32768) {
        launch_row_fast_large_inplace_pipeline_forward_kernel<
            scalar_t,
            accscalar_t,
            32768>(
            input_ptr,
            output_ptr,
            outer_size,
            dim_size,
            grid_x,
            acl_stream);
      } else {
        launch_row_fast_large_inplace_pipeline_forward_kernel<
            scalar_t,
            accscalar_t,
            kLargeRowFp16TileElements>(
            input_ptr,
            output_ptr,
            outer_size,
            dim_size,
            grid_x,
            acl_stream);
      }
    } else {
      launch_row_fast_large_recompute_forward_kernel<
          scalar_t,
          accscalar_t,
          outscalar_t,
          kLargeRowFp32TileElements>(
          input_ptr,
          output_ptr,
          outer_size,
          dim_size,
          block_x,
          block_y,
          grid_x,
          acl_stream);
    }
    return;
  }

  if (use_register_like_row_softmax_fast(dim_size, block_x)) {
    switch (row_softmax_fast_register_count(dim_size, block_x)) {
      case 2:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 2>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      case 3:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 3>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      case 4:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 4>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      case 5:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 5>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      case 6:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 6>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      case 7:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 7>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      case 8:
        launch_row_fast_reg_forward_kernel<scalar_t, accscalar_t, outscalar_t, 8>(
            input_ptr, output_ptr, outer_size, dim_size, block_x, block_y,
            grid_x, dynamic_ubuf_bytes, acl_stream);
        return;
      default:
        break;
    }
  }

  row_softmax_fast_forward_kernel<
      scalar_t,
      accscalar_t,
      outscalar_t>
      <<<grid_x, dynamic_ubuf_bytes, acl_stream>>>(
          output_ptr,
          input_ptr,
          outer_size,
          dim_size,
          block_x,
          block_y);
}

} // namespace

void dispatch_row_fast_forward_kernel(
    const __fp16* input_ptr,
    __fp16* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  dispatch_row_fast_forward_kernel_impl<__fp16, float, __fp16>(
      input_ptr,
      output_ptr,
      outer_size,
      dim_size,
      block_x,
      block_y,
      grid_x,
      dynamic_ubuf_bytes,
      acl_stream);
}

void dispatch_row_fast_forward_kernel(
    const float* input_ptr,
    float* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  dispatch_row_fast_forward_kernel_impl<float, float, float>(
      input_ptr,
      output_ptr,
      outer_size,
      dim_size,
      block_x,
      block_y,
      grid_x,
      dynamic_ubuf_bytes,
      acl_stream);
}

void dispatch_row_fast_large_tiled_forward_kernel(
    const __fp16* input_ptr,
    __fp16* output_ptr,
    float* row_max_ptr,
    float* row_inv_sum_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  launch_row_fast_large_tiled_forward_kernel<
      __fp16,
      float,
      __fp16>(
      input_ptr,
      output_ptr,
      row_max_ptr,
      row_inv_sum_ptr,
      outer_size,
      dim_size,
      block_x,
      block_y,
      grid_x,
      dynamic_ubuf_bytes,
      acl_stream);
}

void dispatch_row_fast_large_tiled_fused_forward_kernel(
    const __fp16* input_ptr,
    __fp16* output_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  constexpr int64_t kTileElements = kLargeRowFp16TileElements;
  constexpr int64_t kPhysicalGridXLimit = 64;
  const int64_t pipeline_grid_x = grid_x < kPhysicalGridXLimit
      ? grid_x
      : kPhysicalGridXLimit;
  row_softmax_fast_large_ub_tiled_fused_pipeline_kernel<
      __fp16,
      kTileElements>
      <<<pipeline_grid_x, 0, acl_stream>>>(
          output_ptr,
          input_ptr,
          outer_size,
          dim_size);
  (void)block_x;
  (void)block_y;
  (void)dynamic_ubuf_bytes;
}

void dispatch_row_fast_large_tiled_forward_kernel(
    const float* input_ptr,
    float* output_ptr,
    float* row_max_ptr,
    float* row_inv_sum_ptr,
    int64_t outer_size,
    int64_t dim_size,
    int64_t block_x,
    int64_t block_y,
    int64_t grid_x,
    int64_t dynamic_ubuf_bytes,
    void* acl_stream) {
  launch_row_fast_large_tiled_forward_kernel<
      float,
      float,
      float>(
      input_ptr,
      output_ptr,
      row_max_ptr,
      row_inv_sum_ptr,
      outer_size,
      dim_size,
      block_x,
      block_y,
      grid_x,
      dynamic_ubuf_bytes,
      acl_stream);
}

} // namespace aten_softmax_v3
